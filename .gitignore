# Node & Dependencies
node_modules/

# Os dois package-lock.json do repositório são versionados de propósito: sem
# lockfile o `npm ci` do CI não roda, e o Dependabot não consegue abrir PR de
# atualização porque não tem com que comparar a árvore de dependências.

# Ambiente e Segredos (NUNCA commitar no git)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
# O exemplo das variáveis de teste é documentação, não segredo.
!backend/.env.test.example
.agents/mcp_config.json
!.agents/mcp_config.example.json

# Arquivo de credenciais LiveKit legado (v1.0.0f e anteriores).
# O cliente NAO deve mais conter segredo algum: o token vem do backend.
livekit.json
**/livekit.json

# Bancos de Dados Locais
*.db
*.db-journal
backend/dev.db*

# Vercel & Cache
.vercel/
.vercelignore

# Binários nativos e arquivos compilados locais (gerados pelo build)
*.exe
*.dll
*.so
PapoCall.exe
PapoCall-Setup.exe
!public/downloads/PapoCall-Setup.exe
data/
backend/dist/

# Flutter / Dart Build Artifacts
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub/
flutter_app/.pub-cache/

# Logs e arquivos temporários
*.log
gitleaks-report.json
desktop/package_temp/
test_junc
.DS_Store
Thumbs.db
