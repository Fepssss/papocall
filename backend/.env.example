# ==============================================================================
# PAPOCALL AUTH SERVICE - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Servidor
PORT=3333
NODE_ENV=development

# Banco de Dados (SQLite para dev local ou PostgreSQL para produção)
# Exemplo SQLite: file:./dev.db
# Exemplo PostgreSQL: postgresql://usuario:senha@localhost:5432/papocall?schema=public
DATABASE_URL="file:./dev.db"

# Banco exclusivo da suíte de testes. Deixe vazio para os testes rodarem contra
# DATABASE_URL: eles ainda assim só apagam as próprias contas de teste.
# Preencha com um banco descartável para não escrever nada no banco operacional.
TEST_DATABASE_URL=""

# CORS - Whitelist de origens permitidas (separadas por vírgula, NUNCA usar '*' em produção)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,https://papocall.vercel.app"

# ------------------------------------------------------------------------------
# Chaves Assimétricas RS256 (RSA 2048 bits) para Assinatura de Access Tokens
# ------------------------------------------------------------------------------
# Em desenvolvimento, se deixadas em branco, o serviço gerará um par efêmero automaticamente.
# Em produção, forneça as chaves em formato PEM (ou base64 codificado).
# Gerar par de chaves no terminal:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Duração dos Tokens
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# Credenciais LiveKit Cloud
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://seu-projeto.livekit.cloud"
LIVEKIT_API_KEY="your_api_key_here"
LIVEKIT_API_SECRET="your_api_secret_here"

# ------------------------------------------------------------------------------
# Configurações de E-mail (Verificação de Conta e Reset de Senha)
# ------------------------------------------------------------------------------
# OBRIGATÓRIO em produção: sem SMTP_HOST o serviço aborta na inicialização.
# O token de redefinição só pode trafegar pelo e-mail — nunca por log, que pode
# ser lido por terceiros e permitiria tomar qualquer conta.
EMAIL_FROM="nao-responda@papocall.com"
FRONTEND_URL="https://papocall.vercel.app"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ------------------------------------------------------------------------------
# Broker MQTT dedicado
# ------------------------------------------------------------------------------
# A credencial do broker é emitida por POST /mqtt/credentials e vale este tempo.
# Curta duração é o que limita o estrago de uma senha arrancada de um aparelho
# emprestado; o aplicativo renova junto do access token.
MQTT_CREDENTIAL_TTL_MINUTES=720

# Onde o broker fica. Chega ao aplicativo por estas variáveis (e não por
# --dart-define) para que trocar de broker seja uma linha no painel do Render, e
# não uma versão nova. Vazio = o aplicativo usa o endereço embutido no build.
# Enquanto o broker próprio não existir, é isto que mantém o caminho atual.
MQTT_HOST=""
MQTT_PORT=8883
MQTT_WSS_URL=""
