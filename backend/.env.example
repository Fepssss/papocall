# ==============================================================================
# PAPOCALL AUTH SERVICE - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Servidor
PORT=3333
NODE_ENV=development

# Banco de Dados (SQLite para dev local ou PostgreSQL para produção)
# Exemplo SQLite: file:./dev.db
# Exemplo PostgreSQL: postgresql://usuario:senha@localhost:5432/papocall?schema=public
DATABASE_URL="file:./dev.db"

# CORS - Whitelist de origens permitidas (separadas por vírgula, NUNCA usar '*' em produção)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,https://papocall.vercel.app"

# ------------------------------------------------------------------------------
# Chaves Assimétricas RS256 (RSA 2048 bits) para Assinatura de Access Tokens
# ------------------------------------------------------------------------------
# Em desenvolvimento, se deixadas em branco, o serviço gerará um par efêmero automaticamente.
# Em produção, forneça as chaves em formato PEM (ou base64 codificado).
# Gerar par de chaves no terminal:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Duração dos Tokens
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# Credenciais LiveKit Cloud
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://seu-projeto.livekit.cloud"
LIVEKIT_API_KEY="your_api_key_here"
LIVEKIT_API_SECRET="your_api_secret_here"

# ------------------------------------------------------------------------------
# Configurações de E-mail (Verificação de Conta e Reset de Senha)
# ------------------------------------------------------------------------------
EMAIL_FROM="nao-responda@papocall.com"
FRONTEND_URL="https://papocall.vercel.app"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
