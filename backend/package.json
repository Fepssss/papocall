{
  "name": "papocall-auth-backend",
  "version": "1.0.0",
  "description": "Backend de autenticação customizada em TypeScript com Argon2id, JWT RS256 e LiveKit",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test tsx --test tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "keywords": [
    "auth",
    "argon2id",
    "jwt",
    "rs256",
    "livekit",
    "papocall"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^7.0.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.0",
    "nodemailer": "^10.0.10",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13"
  }
}
