# =============================================================================
# CONFIGURACAO DO SERVIDOR (nunca commitar o .env real)
# =============================================================================
# ATENCAO: estas credenciais pertencem EXCLUSIVAMENTE ao servidor.
# Elas NUNCA devem ser embutidas no aplicativo Flutter distribuido: qualquer
# segredo dentro do binario entregue ao usuario e considerado publico.
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Chave publica RSA usada pela funcao serverless para validar o access token
# emitido pelo backend de autenticacao (backend/.env guarda a chave privada).
JWT_PUBLIC_KEY=

# Origens autorizadas a chamar a API pelo navegador (separadas por virgula).
CORS_ORIGINS=https://papocall.vercel.app

# =============================================================================
# CONFIGURACAO PUBLICA DO APP (segura para ir ao binario)
# =============================================================================
# Endereco do backend que o aplicativo consulta para autenticacao e para
# solicitar o token de voz. Precisa ser HTTPS e estar publicamente acessivel.
PAPOCALL_API_URL=https://papocall.onrender.com
